# Copy to .env and fill in. Sandbox credentials only; never commit .env.

# PayPal sandbox REST app
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
# Public by design: used by the checkout buttons in the browser
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-sandbox-client-id

# Runtime AI (Stage B)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=your-gemini-api-key
AI_DAILY_CALL_CAP=200

# Keys the buyer hash; at least 32 random bytes
HMAC_SECRET=replace-with-at-least-32-random-bytes

DATABASE_URL=file:./dev.db
DEMO_MODE=true
SYNC_INTERVAL_SECONDS=900
